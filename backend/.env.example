# Cấu hình Server
PORT=5000

# Cấu hình Database (SQL Server)
DB_SERVER=localhost
# Tên database: 
DB_DATABASE=

# Đặt là true nếu dùng Windows Authentication, false nếu dùng SQL Login
DB_TRUSTED_CONNECTION=true

# Nếu dùng SQL Login (DB_TRUSTED_CONNECTION=false) thì điền 2 dòng dưới
DB_USER=your_username_here
DB_PASSWORD=your_password_here

# Nếu dùng bản SQL Express, có thể cần điền Instance Name (ví dụ: SQLEXPRESS)
DB_INSTANCE=